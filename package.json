{
  "type": "module",
  "name": "vite-react-file-router",
  "description": "A Vite plugin that generates react-router routes from your component directory tree",
  "author": "Travis J True",
  "version": "0.4.0",
  "license": "MIT",
  "files": [
    "dist",
    "src/plugin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "file-based-routing",
    "react",
    "react-router",
    "routing",
    "vite",
    "vite-plugin"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./404": "./dist/404.jsx",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travistrue2008/vite-react-file-router.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/plugin/404.jsx src/plugin/client.d.ts dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "rolldown": "^1.2.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-router": "^8",
    "vite": "^8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "9.20.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8"
  }
}
